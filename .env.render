# Environment variables template for Render deployment
# Copy these to your Render service environment variables

# Required - Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# Optional - ElevenLabs TTS (falls back to espeak without this)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=jqcCZkN6Knx8BJ5TBdYR
ELEVENLABS_AGENT_ID=your-agent-id
ELEVENLABS_BRANCH_ID=your-branch-id

# Optional - Africa's Talking SMS
AFRICASTALKING_USERNAME=Kwepo
AFRICASTALKING_API_KEY=your-africastalking-api-key-here
AFRICASTALKING_SENDER_ID=20880

# Optional - Google Colab GPU acceleration
COLAB_SADTALKER_URL=https://your-ngrok-url.ngrok-free.app

# Server Configuration (set automatically by Render)
HOST=0.0.0.0
PORT=$PORT
DEBUG=false

# CORS Configuration (update with your frontend URL)
CORS_ORIGINS=https://rafiki-frontend.onrender.com,https://your-custom-domain.com

# Session Configuration
SESSION_SECRET_KEY=your-random-secret-key-here
SESSION_EXPIRE_MINUTES=60
SESSION_TIMEOUT_MINUTES=30

# Database (if using PostgreSQL on Render)
# DATABASE_URL=$DATABASE_URL

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
