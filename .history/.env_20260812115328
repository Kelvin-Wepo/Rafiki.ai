# eCitizen Voice Assistant - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="eCitizen Voice Assistant"
APP_ENV=development
DEBUG=true
SECRET_KEY=8d8a41f7771d6159b4e1fa5ffbe0c9537897505a8282d6e37a89f568ccc0438e

# ===========================================
# SERVER SETTINGS
# ===========================================
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# CORS SETTINGS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# GOOGLE GEMINI API
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Recommended model for best multilingual performance
GEMINI_MODEL=gemini-2.5

# Google Cloud API key (optional). Preferred for TTS if you don't use a service account JSON.
# You can also set GOOGLE_APPLICATION_CREDENTIALS to the path of a service account JSON file for full Google Cloud access.
GOOGLE_API_KEY=your-google-api-key-here

# OTP simulation for local development (do NOT enable in production)
OTP_SIMULATE=false

# ===========================================
# GOOGLE DIALOGFLOW
# ===========================================
# Create a Dialogflow project at: https://dialogflow.cloud.google.com/
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id
DIALOGFLOW_LANGUAGE_CODE=en
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/dialogflow-credentials.json

