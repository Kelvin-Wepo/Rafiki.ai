# eCitizen Voice Assistant - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="eCitizen Voice Assistant"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-a-secure-one

# ===========================================
# SERVER SETTINGS
# ===========================================
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# CORS SETTINGS
# ===========================================
# Match the frontend dev ports used by Vite (5173) and React (3000).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# FRONTEND SETTINGS (frontend/.env)
# ===========================================
# Base URL the frontend uses for all backend API calls.
VITE_API_URL=http://localhost:8000
VITE_ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id

# ===========================================
# GOOGLE GEMINI API
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Recommended model for best multilingual performance
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud API key (optional). Preferred for TTS if you don't use a service account JSON.
# You can also set GOOGLE_APPLICATION_CREDENTIALS to the path of a service account JSON file for full Google Cloud access.
GOOGLE_API_KEY=your-google-api-key-here

# OTP simulation for local development (do NOT enable in production)
OTP_SIMULATE=false

# ===========================================
# GOOGLE DIALOGFLOW
# ===========================================
# Create a Dialogflow project at: https://dialogflow.cloud.google.com/
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id
DIALOGFLOW_LANGUAGE_CODE=en
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/dialogflow-credentials.json

# ===========================================
# AFRICA'S TALKING SMS & VOICE
# ===========================================
# Sign up at: https://africastalking.com/ then open the app and use
# Settings -> API Key to generate a key. The key is shown once.
# The username must belong to the same app as the key, otherwise every request
# returns "The supplied authentication is invalid".
# Use username `sandbox` only with a sandbox app's key.
AFRICASTALKING_USERNAME=your-africastalking-app-username
AFRICASTALKING_API_KEY=your-africastalking-api-key-here
# Alphanumeric sender IDs must be registered with Africa's Talking first.
AFRICASTALKING_SENDER_ID=20880
AFRICASTALKING_VIRTUAL_NUMBER=+254711082025

# ===========================================
# ELEVENLABS (VOICE)
# ===========================================
# https://elevenlabs.io/app/settings/api-keys
# IMPORTANT: use the API *key*, which starts with `sk_` and is only shown when
# the key is created or rotated. The long hex string labelled as the key ID in
# the dashboard is NOT a usable key and the API rejects it with
# "API key ID used as API key".
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key-here
# Conversational AI agent that powers dashboard voice mode.
ELEVENLABS_AGENT_ID=agent_your-agent-id
# Default TTS voice — pinned per session so language changes cannot swap it.
ELEVENLABS_VOICE_ID=jqcCZkN6Knx8BJ5TBdYR

# ===========================================
# EMAIL / SMTP SETTINGS
# ===========================================
# For Gmail SMTP, create an App Password if using 2FA:
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kelvinwepo7710@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=kelvinwepo7710@gmail.com
SMTP_FROM_NAME="Kelvin Wepo"
EMAIL_ENABLED=true

# ===========================================
# DATABASE SETTINGS
# ===========================================
# SQLite (Development)
DATABASE_URL=sqlite:///./ecitizen.db

# PostgreSQL (Production) - uncomment and configure
# DATABASE_URL=postgresql://user:password@localhost:5432/ecitizen

# ===========================================
# REDIS (Optional - for caching and sessions)
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# SESSION SETTINGS
# ===========================================
SESSION_TIMEOUT_MINUTES=30
SESSION_SECRET=your-session-secret-here

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ===========================================
# VOICE SETTINGS
# ===========================================
SPEECH_RECOGNITION_LANGUAGE=en-KE
TTS_RATE=150
TTS_VOICE_ID=1

# ===========================================
# ECITIZEN API (if available)
# ===========================================
# ECITIZEN_API_URL=https://api.ecitizen.go.ke
# ECITIZEN_API_KEY=your-ecitizen-api-key

# ===========================================
# SMS TEMPLATES
# ===========================================
SMS_CONFIRMATION_TEMPLATE="Your eCitizen appointment is confirmed for {date} at {time}. Ref: {reference}"
SMS_REMINDER_TEMPLATE="Reminder: Your eCitizen appointment is tomorrow at {time}. Ref: {reference}"
